{
  "name": "quality-engineering-lab-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test",
    "test:web": "playwright test tests/web",
    "test:api": "playwright test tests/api",
    "test:security": "playwright test --grep @security",
    "test:smoke": "playwright test --grep @smoke",
    "test:post-merge-smoke": "playwright test --grep @post-merge-smoke",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "report:summary": "node scripts/generate-quality-summary.mjs",
    "performance:smoke": "node performance/run.mjs smoke",
    "performance:post-merge-smoke": "node performance/run.mjs post-merge-smoke",
    "performance:load": "node performance/run.mjs load",
    "experiment:functional": "node ../experiments/run.mjs EXP-001",
    "experiment:performance": "node ../experiments/run.mjs EXP-002",
    "experiment:security": "node ../experiments/run.mjs EXP-003",
    "experiment:all": "node ../experiments/run.mjs all",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "dotenv": "17.4.2",
    "typescript": "7.0.2"
  }
}
